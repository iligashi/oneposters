# Copy to .env.local (or run `vercel env pull .env.local`) and fill in.

# Supabase (Project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Used by /api/orders and /api/promo. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Blob (product images and studio uploads)
BLOB_READ_WRITE_TOKEN=
# Customer studio uploads are private by default (served only to their owner
# and staff via /api/studio/artwork). The Blob store must support private
# blobs. Set "public" only as a temporary opt-out.
# STUDIO_BLOB_ACCESS=public
# Artwork uploaded before the private default is still public. It keeps being
# served while this is on (default). After `pnpm audit:artwork --migrate`
# reports "Still public: 0", set it to off to retire the legacy public path.
# STUDIO_ARTWORK_PUBLIC_FALLBACK=off

# Optional bot protection (Cloudflare Turnstile). Leave empty to disable.
# For sign-up, also enable CAPTCHA protection in Supabase Auth with the same secret.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Optional: POST server errors to an alerting webhook (Slack, Discord, ...).
# ERROR_WEBHOOK_URL=

# Optional: auth redirect URL for local development.
# NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback
