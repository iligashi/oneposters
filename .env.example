# Copy to .env.local (or run `vercel env pull .env.local`) and fill in.

# Supabase (Project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Used by /api/orders and /api/promo. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Blob (product images and studio uploads)
BLOB_READ_WRITE_TOKEN=
# "private" once the Blob store supports private blobs; default is "public".
# STUDIO_BLOB_ACCESS=private

# Optional bot protection (Cloudflare Turnstile). Leave empty to disable.
# For sign-up, also enable CAPTCHA protection in Supabase Auth with the same secret.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Optional: POST server errors to an alerting webhook (Slack, Discord, ...).
# ERROR_WEBHOOK_URL=

# Optional: auth redirect URL for local development.
# NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback
